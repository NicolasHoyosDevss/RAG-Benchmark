# Environment Variables for RAG Benchmark

# OpenAI API configuration
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace models configuration (for TGI/vLLM endpoints)
# These are required when running evaluations with HuggingFace SLMs (MediPhi, MedGemma)

# HuggingFace API token for authentication with HF endpoints
HF_TOKEN=your_huggingface_token_here

# TGI/vLLM Inference Endpoint for MediPhi (microsoft/MediPhi)
# Should be the base URL without /v1 (e.g., https://mediphi-endpoint.huggingface.co)
MEDIPHI_ENDPOINT_URL=https://your_mediphi_endpoint_url

# TGI/vLLM Inference Endpoint for MedGemma (google/medgemma-4b-it)
# Should be the base URL without /v1 (e.g., https://medgemma-endpoint.huggingface.co)
MEDGEMMA_ENDPOINT_URL=https://your_medgemma_endpoint_url

# PageIndex configuration
PAGEINDEX_API_KEY=your_pageindex_api_key_here
PAGEINDEX_DOC_ID=your_pageindex_doc_id_here
